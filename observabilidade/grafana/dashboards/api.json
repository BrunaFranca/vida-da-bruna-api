{
  "uid": "api-red",
  "title": "API · RED (taxa, erros, duração)",
  "tags": ["vida-da-bruna", "red"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "schemaVersion": 41,
  "panels": [
    {
      "type": "timeseries",
      "title": "Requisições por segundo, por rota",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_request_method, http_route) (rate(http_server_request_duration_seconds_count{job=\"vida-da-bruna-api\", http_route!~\".*/stream\"}[1m]))",
          "legendFormat": "{{http_request_method}} {{http_route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Erros 5xx (% das requisições)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "red" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"vida-da-bruna-api\", http_route!~\".*/stream\", http_response_status_code=~\"5..\"}[1m])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{job=\"vida-da-bruna-api\", http_route!~\".*/stream\"}[1m]))",
          "legendFormat": "erros"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latência (p50 / p95 / p99) · clique num ponto para abrir o trace",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "transparent", "value": null }, { "color": "orange", "value": 0.3 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"vida-da-bruna-api\", http_route!~\".*/stream\"}[1m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"vida-da-bruna-api\", http_route!~\".*/stream\"}[1m])))", "legendFormat": "p95", "exemplar": true },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"vida-da-bruna-api\", http_route!~\".*/stream\"}[1m])))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Banco: duração das queries (p95)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(db_client_operation_duration_seconds_bucket{job=\"vida-da-bruna-api\"}[1m])))", "legendFormat": "p95" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tempo real: conexões SSE abertas",
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(api_streams_abertos{job=\"vida-da-bruna-api\"})", "legendFormat": "streams" } ]
    },
    {
      "type": "logs",
      "title": "Logs da API (clique no trace_id para abrir o trace)",
      "gridPos": { "x": 0, "y": 17, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true },
      "targets": [ { "refId": "A", "expr": "{service_name=\"vida-da-bruna-api\"}" } ]
    }
  ]
}
