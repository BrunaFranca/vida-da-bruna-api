{
  "uid": "slo",
  "title": "API · SLOs (30 dias)",
  "tags": ["vida-da-bruna", "slo"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "schemaVersion": 41,
  "panels": [
    { "type": "row", "title": "Disponibilidade · meta 99,5% sem 5xx", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 } },
    {
      "type": "stat",
      "title": "SLI (30 dias)",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 0.995 } ] }
        },
        "overrides": []
      },
      "targets": [ { "refId": "A", "expr": "1 - ((sum(increase(http_server_request_duration_seconds_count{job=\"vida-da-bruna-api\", http_route=~\"/v1/.*\", http_route!~\".*/stream\", http_response_status_code=~\"5..\"}[30d])) or vector(0)) / sum(increase(http_server_request_duration_seconds_count{job=\"vida-da-bruna-api\", http_route=~\"/v1/.*\", http_route!~\".*/stream\"}[30d])))" } ]
    },
    {
      "type": "stat",
      "title": "Error budget restante",
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 0.25 }, { "color": "green", "value": 0.5 } ] }
        },
        "overrides": []
      },
      "targets": [ { "refId": "A", "expr": "1 - (((sum(increase(http_server_request_duration_seconds_count{job=\"vida-da-bruna-api\", http_route=~\"/v1/.*\", http_route!~\".*/stream\", http_response_status_code=~\"5..\"}[30d])) or vector(0)) / sum(increase(http_server_request_duration_seconds_count{job=\"vida-da-bruna-api\", http_route=~\"/v1/.*\", http_route!~\".*/stream\"}[30d]))) / 0.005)" } ]
    },
    {
      "type": "timeseries",
      "title": "Burn rate (linhas: 6x warning, 14,4x critical)",
      "gridPos": { "x": 12, "y": 1, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "transparent", "value": null }, { "color": "orange", "value": 6 }, { "color": "red", "value": 14.4 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "slo:disponibilidade:erros_razao5m / 0.005", "legendFormat": "5m" },
        { "refId": "B", "expr": "slo:disponibilidade:erros_razao1h / 0.005", "legendFormat": "1h" },
        { "refId": "C", "expr": "slo:disponibilidade:erros_razao6h / 0.005", "legendFormat": "6h" }
      ]
    },

    { "type": "row", "title": "Latência · meta 95% abaixo de 300 ms", "gridPos": { "x": 0, "y": 7, "w": 24, "h": 1 } },
    {
      "type": "stat",
      "title": "SLI (30 dias)",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 0.95 } ] }
        },
        "overrides": []
      },
      "targets": [ { "refId": "A", "expr": "sum(increase(http_server_request_duration_seconds_bucket{job=\"vida-da-bruna-api\", http_route=~\"/v1/.*\", http_route!~\".*/stream\", le=\"0.3\"}[30d])) / sum(increase(http_server_request_duration_seconds_count{job=\"vida-da-bruna-api\", http_route=~\"/v1/.*\", http_route!~\".*/stream\"}[30d]))" } ]
    },
    {
      "type": "stat",
      "title": "Error budget restante",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 0.25 }, { "color": "green", "value": 0.5 } ] }
        },
        "overrides": []
      },
      "targets": [ { "refId": "A", "expr": "1 - ((1 - sum(increase(http_server_request_duration_seconds_bucket{job=\"vida-da-bruna-api\", http_route=~\"/v1/.*\", http_route!~\".*/stream\", le=\"0.3\"}[30d])) / sum(increase(http_server_request_duration_seconds_count{job=\"vida-da-bruna-api\", http_route=~\"/v1/.*\", http_route!~\".*/stream\"}[30d]))) / 0.05)" } ]
    },
    {
      "type": "timeseries",
      "title": "Burn rate (linhas: 6x warning, 14,4x critical)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "transparent", "value": null }, { "color": "orange", "value": 6 }, { "color": "red", "value": 14.4 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "slo:latencia:lentas_razao5m / 0.05", "legendFormat": "5m" },
        { "refId": "B", "expr": "slo:latencia:lentas_razao1h / 0.05", "legendFormat": "1h" },
        { "refId": "C", "expr": "slo:latencia:lentas_razao6h / 0.05", "legendFormat": "6h" }
      ]
    },

    { "type": "row", "title": "Alertas", "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 } },
    {
      "type": "alertlist",
      "title": "Alertas de SLO",
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 7 },
      "options": {
        "alertInstanceLabelFilter": "",
        "datasource": "Mimir",
        "groupMode": "default",
        "maxItems": 20,
        "sortOrder": 1,
        "stateFilter": { "firing": true, "pending": true, "normal": true },
        "viewMode": "list"
      }
    }
  ]
}
